# /etc/spacy/api.env on the EC2 instance.
# Copy this template, fill in the secrets, then `chmod 600 /etc/spacy/api.env`.
# docker-compose loads it via `env_file:` — secrets never enter the image.

DATABASE_URL=postgresql://spacy:dev@postgres:5432/spacy?schema=public
PORT=8080
NODE_ENV=production
APP_BASE_URL=https://api.spacy.computer
WEB_BASE_URL=https://spacy.computer
LOG_LEVEL=info

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.spacy.computer/auth/google/callback
JWT_SECRET=
JWT_ISSUER=spacy
JWT_AUDIENCE=spacy-web
COOKIE_DOMAIN=.spacy.computer
COOKIE_SAMESITE=lax

ORBITPORT_BASE_URL=https://op.spacecomputer.io
ORBITPORT_AUTH_URL=https://auth.spacecomputer.io
ORBITPORT_CLIENT_ID=
ORBITPORT_CLIENT_SECRET=

PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
TRUST_ANCHOR_BUNDLE_CID=bafkreieshqgrwwhfsh3ahcgyhsqbggchbo3hsi5wpvhrycu7vp7ow6vkay
CTRNG_IPFS_BEACON_URL=https://ipfs.io/ipns/k2k4r8lvomw737sajfnpav0dpeernugnryng50uheyk1k39lursmn09f
VERIFY_INSTRUCTIONS_URL=https://spacy.computer/verify
ATTESTATION_SPEC_URL=https://spacy.computer/spec/attestation/v1

CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia.publicnode.com
ATTESTATION_CONTRACT_ADDRESS=0xCe31398be624975941e71F94eC6D4c5472449B00
RELAYER_PRIVATE_KEY=

SEV_GUEST_DEVICE=/dev/sev-guest
SELF_ATTESTATION_REFRESH_HOURS=12
MOCK_ATTESTATION=false
