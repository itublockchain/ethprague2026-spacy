{
  "name": "spacy",
  "private": true,
  "version": "0.0.0",
  "description": "Orbital threshold wallet — signed above the atmosphere",
  "license": "AGPL-3.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run db:up && bun run db:wait && bun run db:migrate && turbo run dev",
    "dev:apps": "turbo run dev",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && bun run db:up && bun run db:wait && bun run db:migrate",
    "db:wait": "until docker exec spacy-pg pg_isready -U spacy -d spacy >/dev/null 2>&1; do sleep 1; done",
    "db:migrate": "bun --filter @spacy/api prisma:deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.8"
  }
}
