# --- Database (in-VM Postgres)
DATABASE_URL="postgresql://spacy:dev@localhost:5432/spacy?schema=public"

# --- Server
PORT=8080
NODE_ENV=development
APP_BASE_URL="http://localhost:8080"
WEB_BASE_URL="http://localhost:5173"
LOG_LEVEL=info

# --- Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:8080/auth/google/callback"
JWT_SECRET=""                       # 48+ random bytes, hex or base64
JWT_ISSUER="spacy"
JWT_AUDIENCE="spacy-web"
COOKIE_DOMAIN=""                    # leave blank for localhost
COOKIE_SAMESITE="lax"               # "strict" in prod

# --- Orbitport (SpaceComputer)
ORBITPORT_BASE_URL="https://op.spacecomputer.io"
ORBITPORT_AUTH_URL="https://auth.spacecomputer.io"
ORBITPORT_CLIENT_ID=""
ORBITPORT_CLIENT_SECRET=""

# --- Pinata (IPFS pinning)
PINATA_JWT=""
PINATA_GATEWAY="https://gateway.pinata.cloud"
# CIDv1 of the pre-pinned Intel TDX + AMD SEV-SNP root cert bundle.
# Verifiers fetch this once and reuse to avoid scraping Intel PCS.
TRUST_ANCHOR_BUNDLE_CID=""
CTRNG_IPFS_BEACON_URL="https://ipfs.io/ipns/k2k4r8lvomw737sajfnpav0dpeernugnryng50uheyk1k39lursmn09f"
VERIFY_INSTRUCTIONS_URL="https://spacy.computer/verify"
ATTESTATION_SPEC_URL="https://spacy.computer/spec/attestation/v1"

# --- Chain
CHAIN_ID=11155111
RPC_URL="https://ethereum-sepolia.publicnode.com"
# SpacyAttestations on Sepolia (deployed 2026-05-08):
# https://sepolia.etherscan.io/address/0xCe31398be624975941e71F94eC6D4c5472449B00
ATTESTATION_CONTRACT_ADDRESS="0xCe31398be624975941e71F94eC6D4c5472449B00"
# Backend uses this key only to emit AttestationPublished events. Distinct
# from the one-time DEPLOYER_PRIVATE_KEY consumed by Foundry at deploy
# time — separating them caps blast radius if either leaks.
RELAYER_PRIVATE_KEY=""

# --- TEE (SEV-SNP)
SEV_GUEST_DEVICE="/dev/sev-guest"
SELF_ATTESTATION_REFRESH_HOURS=12
MOCK_ATTESTATION=true
