# Spacy backend URL (defaults to http://localhost:8080 if unset).
VITE_SPACY_API_URL=http://localhost:8080

# Optional Sepolia RPC override (defaults to viem's public endpoint).
# Use an Alchemy/Infura/Tenderly key in production for rate-limit headroom.
VITE_SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
