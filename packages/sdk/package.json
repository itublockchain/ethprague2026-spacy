{
  "name": "@spacy-computer/sdk",
  "version": "0.0.1-alpha.0",
  "description": "Spacy SDK — embedded wallet whose signing key lives in SpaceComputer's Intel TDX KMS, with cosmic-randomness witnesses and on-chain attestation receipts.",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itublockchain/spacy.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://spacy.computer",
  "bugs": {
    "url": "https://github.com/itublockchain/spacy/issues"
  },
  "keywords": [
    "spacy",
    "spacecomputer",
    "orbitport",
    "tee",
    "tdx",
    "sev-snp",
    "ethereum",
    "embedded-wallet",
    "attestation",
    "ipfs",
    "ctrng",
    "viem"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@spacy/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "viem": "^2.21.0"
  },
  "sideEffects": false
}
